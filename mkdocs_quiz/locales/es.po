#: plugin.py:586 plugin.py:960
msgid "Submit"
msgstr "Enviar"

#: plugin.py:516
msgid "Answer"
msgstr "Respuesta"

#: plugin.py:582 plugin.py:975
msgid "Question {n}"
msgstr "Pregunta {n}"

#: plugin.py:134 plugin.py:1005
msgid "Quiz Progress"
msgstr "Progreso del cuestionario"

#: plugin.py:1006
msgid "questions answered"
msgstr "preguntas respondidas"

#: plugin.py:1007
msgid "correct"
msgstr "correctas"

#: plugin.py:1008
msgid "Quiz Complete!"
msgstr "¡Cuestionario completado!"

#: plugin.py:1009 plugin.py:1049
msgid "Reset quiz"
msgstr "Reiniciar cuestionario"

#: plugin.py:1046
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"Los resultados del cuestionario se guardan en el almacenamiento local de tu "
"navegador y persistirán entre sesiones."

#: js/quiz.js:333
msgid "Outstanding! You aced it!"
msgstr "¡Excepcional! ¡Lo has clavado!"

#: js/quiz.js:336
msgid "Great job! You really know your stuff!"
msgstr "¡Buen trabajo! ¡Realmente conoces el tema!"

#: js/quiz.js:339
msgid "Good effort! Keep learning!"
msgstr "¡Buen esfuerzo! ¡Sigue aprendiendo!"

#: js/quiz.js:342
msgid "Not bad, but there's room for improvement!"
msgstr "¡No está mal, pero hay margen de mejora!"

#: js/quiz.js:345
msgid "Better luck next time! Keep trying!"
msgstr "¡Mejor suerte la próxima vez! ¡Sigue intentándolo!"

#: js/quiz.js:461 js/quiz.js:615 js/quiz.js:628
msgid ""
"Are you sure you want to reset the quiz? This will clear your progress."
msgstr ""
"¿Estás seguro de que quieres reiniciar el cuestionario? Esto borrará tu "
"progreso."

#: js/quiz.js:691
msgid "Try Again"
msgstr "Intentar de nuevo"

#: js/quiz.js:563
msgid "Correct answer!"
msgstr "¡Respuesta correcta!"

#: js/quiz.js:564
msgid "Incorrect answer. Please try again."
msgstr "Respuesta incorrecta. Por favor, inténtalo de nuevo."

#: js/quiz.js:564
msgid "Incorrect answer."
msgstr "Respuesta incorrecta."

#: plugin.py:135
msgid "Answered:"
msgstr "Respondidas:"

#: plugin.py:136
msgid "Correct:"
msgstr "Correctas:"

#: plugin.py:137
msgid "Reset"
msgstr "Reiniciar"

#: js/quiz.js:781
msgid "(empty)"
msgstr "(vacío)"
