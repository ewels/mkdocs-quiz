#: plugin.py:586 plugin.py:960
msgid "Submit"
msgstr "Sendi"

#: plugin.py:516
msgid "Answer"
msgstr "Respondo"

#: plugin.py:582 plugin.py:975
msgid "Question {n}"
msgstr "Demando {n}"

#: plugin.py:134 plugin.py:1005
msgid "Quiz Progress"
msgstr "Kvizo-Progreso"

#: plugin.py:1006
msgid "questions answered"
msgstr "demandoj responditaj"

#: plugin.py:1007
msgid "correct"
msgstr "ĝustaj"

#: plugin.py:1008
msgid "Quiz Complete!"
msgstr "Kvizo Finita!"

#: plugin.py:1009 plugin.py:1049
msgid "Reset quiz"
msgstr "Restarigi kvizon"

#: plugin.py:1046
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"Kvizo-rezultoj estas konservitaj en la loka memoro de via retumilo kaj "
"restos inter sesioj."

#: js/quiz.js:333
msgid "Outstanding! You aced it!"
msgstr "Elstare! Vi perfekte sukcesis!"

#: js/quiz.js:336
msgid "Great job! You really know your stuff!"
msgstr "Bonega laboro! Vi vere konas vian aferon!"

#: js/quiz.js:339
msgid "Good effort! Keep learning!"
msgstr "Bona klopodo! Daŭrigu lerni!"

#: js/quiz.js:342
msgid "Not bad, but there's room for improvement!"
msgstr "Ne malbona, sed estas loko por plibonigo!"

#: js/quiz.js:345
msgid "Better luck next time! Keep trying!"
msgstr "Pli bona ŝanco venontfoje! Daŭrigu provi!"

#: js/quiz.js:461 js/quiz.js:615 js/quiz.js:628
msgid ""
"Are you sure you want to reset the quiz? This will clear your progress."
msgstr ""
"Ĉu vi certas, ke vi volas restarigi la kvizon? Tio forigos vian progreson."

#: js/quiz.js:691
msgid "Try Again"
msgstr "Reprovi"

#: js/quiz.js:563
msgid "Correct answer!"
msgstr "Ĝusta respondo!"

#: js/quiz.js:564
msgid "Incorrect answer. Please try again."
msgstr "Malĝusta respondo. Bonvolu reprovi."

#: js/quiz.js:564
msgid "Incorrect answer."
msgstr "Malĝusta respondo."

#: plugin.py:135
msgid "Answered:"
msgstr "Respondita:"

#: plugin.py:136
msgid "Correct:"
msgstr "Ĝusta:"

