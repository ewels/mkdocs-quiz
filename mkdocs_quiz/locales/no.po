#: plugin.py:593 plugin.py:967
msgid "Submit"
msgstr "Send inn"

#: plugin.py:523
msgid "Answer"
msgstr "Svar"

#: plugin.py:589 plugin.py:982
msgid "Question {n}"
msgstr "Spørsmål {n}"

#: plugin.py:141 plugin.py:1012
msgid "Quiz Progress"
msgstr "Pågående quiz"

#: plugin.py:1013
msgid "questions answered"
msgstr "spørsmål besvart"

#: plugin.py:1014
msgid "correct"
msgstr "riktig"

#: plugin.py:1015
msgid "Quiz Complete!"
msgstr "Quiz fullført!"

#: plugin.py:1016 plugin.py:1056
msgid "Reset quiz"
msgstr "Tilbakestill quiz"

#: plugin.py:1053
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"Quiz resultatene blir liggende i nettleserens lokale lagring og vil bestå "
"mellom økter."

#: js/quiz.js:333
msgid "Outstanding! You aced it!"
msgstr "Utmerket! Du er virkelig et ess!"

#: js/quiz.js:336
msgid "Great job! You really know your stuff!"
msgstr "Bra jobba! Det her var du flink på!"

#: js/quiz.js:339
msgid "Good effort! Keep learning!"
msgstr "Godt forsøk! Dette emnet kan du mye om!"

#: js/quiz.js:342
msgid "Not bad, but there's room for improvement!"
msgstr "Ikke verst, men det finnes rom for forbedring!"

#: js/quiz.js:345
msgid "Better luck next time! Keep trying!"
msgstr "Bedre lykke neste gang! Ikke gi opp!"

#: js/quiz.js:461 js/quiz.js:615 js/quiz.js:628
msgid ""
"Are you sure you want to reset the quiz? This will clear your progress."
msgstr ""
"Er du sikker på at du vil tilbakestille quizen? Dette vil slette fremgangen "
"din."

#: js/quiz.js:691
msgid "Try Again"
msgstr "Prøv igjen"

#: js/quiz.js:563
msgid "Correct answer!"
msgstr "Riktig svar!"

#: js/quiz.js:564
msgid "Incorrect answer. Please try again."
msgstr "Feil svar. Vennligst prøv igjen."

#: js/quiz.js:564
msgid "Incorrect answer."
msgstr "Feil svar."

#: plugin.py:142
msgid "Answered:"
msgstr "Besvart:"

#: plugin.py:143
msgid "Correct:"
msgstr "Riktig:"

#: plugin.py:144
msgid "Reset"
msgstr "Tilbakestill"

