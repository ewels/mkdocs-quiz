#: plugin.py:593 plugin.py:967
msgid "Submit"
msgstr "Absenden"

#: plugin.py:523
msgid "Answer"
msgstr "Antwort"

#: plugin.py:589 plugin.py:982
msgid "Question {n}"
msgstr "Frage {n}"

#: plugin.py:141 plugin.py:1012
msgid "Quiz Progress"
msgstr "Quiz-Fortschritt"

#: plugin.py:1013
msgid "questions answered"
msgstr "Fragen beantwortet"

#: plugin.py:1014
msgid "correct"
msgstr "richtig"

#: plugin.py:1015
msgid "Quiz Complete!"
msgstr "Quiz abgeschlossen!"

#: plugin.py:1016 plugin.py:1056
msgid "Reset quiz"
msgstr "Quiz zurücksetzen"

#: plugin.py:1053
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"Quiz-Ergebnisse werden im lokalen Speicher Ihres Browsers gespeichert und "
"bleiben zwischen Sitzungen erhalten."

#: js/quiz.js:333
msgid "Outstanding! You aced it!"
msgstr "Hervorragend! Du hast es perfekt gemacht!"

#: js/quiz.js:336
msgid "Great job! You really know your stuff!"
msgstr "Großartige Arbeit! Du kennst dich wirklich aus!"

#: js/quiz.js:339
msgid "Good effort! Keep learning!"
msgstr "Gute Leistung! Lerne weiter!"

#: js/quiz.js:342
msgid "Not bad, but there's room for improvement!"
msgstr "Nicht schlecht, aber es gibt noch Verbesserungspotenzial!"

#: js/quiz.js:345
msgid "Better luck next time! Keep trying!"
msgstr "Viel Glück beim nächsten Mal! Versuch es weiter!"

#: js/quiz.js:461 js/quiz.js:615 js/quiz.js:628
msgid ""
"Are you sure you want to reset the quiz? This will clear your progress."
msgstr ""
"Bist du sicher, dass du das Quiz zurücksetzen möchtest? Dies löscht deinen "
"Fortschritt."

#: js/quiz.js:691
msgid "Try Again"
msgstr "Erneut versuchen"

#: js/quiz.js:563
msgid "Correct answer!"
msgstr "Richtige Antwort!"

#: js/quiz.js:564
msgid "Incorrect answer. Please try again."
msgstr "Falsche Antwort. Bitte versuche es erneut."

#: js/quiz.js:564
msgid "Incorrect answer."
msgstr "Falsche Antwort."

#: plugin.py:142
msgid "Answered:"
msgstr "Beantwortet:"

#: plugin.py:143
msgid "Correct:"
msgstr "Richtig:"

#: plugin.py:144
msgid "Reset"
msgstr "Zurücksetzen"

