#: plugin.py:593 plugin.py:967
msgid "Submit"
msgstr "जमा करें"

#: plugin.py:523
msgid "Answer"
msgstr "उत्तर"

#: plugin.py:589 plugin.py:982
msgid "Question {n}"
msgstr "प्रश्न {n}"

#: plugin.py:141 plugin.py:1012
msgid "Quiz Progress"
msgstr "क्विज़ प्रगति"

#: plugin.py:1013
msgid "questions answered"
msgstr "प्रश्नों के उत्तर दिए गए"

#: plugin.py:1014
msgid "correct"
msgstr "सही"

#: plugin.py:1015
msgid "Quiz Complete!"
msgstr "क्विज़ पूर्ण!"

#: plugin.py:1016 plugin.py:1056
msgid "Reset quiz"
msgstr "क्विज़ रीसेट करें"

#: plugin.py:1053
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"क्विज़ परिणाम आपके ब्राउज़र के स्थानीय संग्रहण में सहेजे जाते हैं और सत्रों "
"के बीच बने रहेंगे।"

#: js/quiz.js:333
msgid "Outstanding! You aced it!"
msgstr "शानदार! आपने बहुत अच्छा किया!"

#: js/quiz.js:336
msgid "Great job! You really know your stuff!"
msgstr "बहुत बढ़िया! आप वाकई इसमें माहिर हैं!"

#: js/quiz.js:339
msgid "Good effort! Keep learning!"
msgstr "अच्छा प्रयास! सीखते रहें!"

#: js/quiz.js:342
msgid "Not bad, but there's room for improvement!"
msgstr "बुरा नहीं, लेकिन सुधार की गुंजाइश है!"

#: js/quiz.js:345
msgid "Better luck next time! Keep trying!"
msgstr "अगली बार बेहतर होगा! कोशिश करते रहें!"

#: js/quiz.js:461 js/quiz.js:615 js/quiz.js:628
msgid ""
"Are you sure you want to reset the quiz? This will clear your progress."
msgstr "क्या आप वाकई क्विज़ रीसेट करना चाहते हैं? इससे आपकी प्रगति मिट जाएगी।"

#: js/quiz.js:691
msgid "Try Again"
msgstr "पुनः प्रयास करें"

#: js/quiz.js:563
msgid "Correct answer!"
msgstr "सही उत्तर!"

#: js/quiz.js:564
msgid "Incorrect answer. Please try again."
msgstr "गलत उत्तर। कृपया पुनः प्रयास करें।"

#: js/quiz.js:564
msgid "Incorrect answer."
msgstr "गलत उत्तर।"

#: plugin.py:142
msgid "Answered:"
msgstr "उत्तर दिए:"

#: plugin.py:143
msgid "Correct:"
msgstr "सही:"

#: plugin.py:144
msgid "Reset"
msgstr "रीसेट"

#: js/quiz.js:781
msgid "(empty)"
msgstr "(खाली)"
