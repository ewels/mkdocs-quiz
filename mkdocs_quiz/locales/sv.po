#: plugin.py:593 plugin.py:967
msgid "Submit"
msgstr "Skicka"

#: plugin.py:523
msgid "Answer"
msgstr "Svar"

#: plugin.py:589 plugin.py:982
msgid "Question {n}"
msgstr "Fråga {n}"

#: plugin.py:141 plugin.py:1012
msgid "Quiz Progress"
msgstr "Quiz-framsteg"

#: plugin.py:1013
msgid "questions answered"
msgstr "frågor besvarade"

#: plugin.py:1014
msgid "correct"
msgstr "korrekt"

#: plugin.py:1015
msgid "Quiz Complete!"
msgstr "Quiz slutfört!"

#: plugin.py:1016 plugin.py:1056
msgid "Reset quiz"
msgstr "Återställ quiz"

#: plugin.py:1053
msgid ""
"Quiz results are saved to your browser's local storage and will persist "
"between sessions."
msgstr ""
"Quiz-resultat sparas i webbläsarens lokala lagring och kommer att finnas "
"kvar mellan sessioner."

#: js/quiz.js:333
msgid "Outstanding! You aced it!"
msgstr "Enastående! Du klarade det perfekt!"

#: js/quiz.js:336
msgid "Great job! You really know your stuff!"
msgstr "Bra gjort! Du kan verkligen dina saker!"

#: js/quiz.js:339
msgid "Good effort! Keep learning!"
msgstr "Bra försök! Fortsätt lära!"

#: js/quiz.js:342
msgid "Not bad, but there's room for improvement!"
msgstr "Inte dåligt, men det finns utrymme för förbättring!"

#: js/quiz.js:345
msgid "Better luck next time! Keep trying!"
msgstr "Bättre lycka nästa gång! Fortsätt försöka!"

#: js/quiz.js:461 js/quiz.js:615 js/quiz.js:628
msgid ""
"Are you sure you want to reset the quiz? This will clear your progress."
msgstr ""
"Är du säker på att du vill återställa quizet? Detta kommer att radera dina "
"framsteg."

#: js/quiz.js:691
msgid "Try Again"
msgstr "Försök igen"

#: js/quiz.js:563
msgid "Correct answer!"
msgstr "Rätt svar!"

#: js/quiz.js:564
msgid "Incorrect answer. Please try again."
msgstr "Fel svar. Försök igen."

#: js/quiz.js:564
msgid "Incorrect answer."
msgstr "Fel svar."

#: plugin.py:142
msgid "Answered:"
msgstr "Besvarade:"

#: plugin.py:143
msgid "Correct:"
msgstr "Korrekta:"

#: plugin.py:144
msgid "Reset"
msgstr "Återställ"

#: js/quiz.js:781
msgid "(empty)"
msgstr "(tomt)"
